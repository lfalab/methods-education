  <question type="multichoice">
    <name>
      <text>W10_Q18</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>In a regression table, a variable has a coefficient listed in Model 1 but a blank cell in Model 2. What does the blank cell mean?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
