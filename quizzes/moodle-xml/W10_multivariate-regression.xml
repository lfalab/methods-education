<quiz>
  <question type="multichoice">
    <name>
      <text>W10_Q01</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which of the following equations represents a multivariate regression?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Y = b0 + b1*X1 + b2*X2]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Y = b0 + b1*X]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Y = b0 * b1 * X1 * X2]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Y = b0 + b1*X1 * b2*X2]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>In a multivariate regression, a researcher reports that the slope on education is -1.14, "holding income constant." What does "holding income constant" mean?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The slope compares individuals (or units) with similar levels of income to isolate the relationship between education and the outcome]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Income was removed from the dataset before running the regression]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Income does not vary in the sample]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The researcher fixed income at its mean value and re-ran the analysis]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q03</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A multivariate regression equation is: Y = 10 + 3*X1 + 2*X2. What is the predicted value of Y when X1 = 4 and X2 = 5?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[32]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[22]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[20]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[25]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q04</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A multivariate regression equation is: Y = 50 - 2*X1 + 0.5*X2. What does the coefficient on X1 tell us?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[For each one-unit increase in X1, Y is expected to decrease by 2 units, holding X2 constant]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[For each one-unit increase in X1, Y is expected to increase by 2 units]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[X1 and Y are unrelated]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[For each one-unit increase in Y, X1 decreases by 2 units]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q05</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the main advantage of multivariate regression over bivariate regression?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It allows us to examine the relationship between one variable and the outcome while accounting for other variables]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It always produces higher R-squared values]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It eliminates the need for a dependent variable]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees that the results are causal]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q06</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Researchers find that ice cream sales predict crime rates. When they add temperature to the model, the coefficient on ice cream sales drops to nearly zero. What role does temperature play in this example?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Temperature is a confounding variable that affects both ice cream sales and crime rates]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Temperature is caused by ice cream sales]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Temperature is the dependent variable]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Temperature is a mediating variable on the pathway from ice cream sales to crime]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q07</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>How does adding a control variable to a regression help address confounding?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It compares units that are similar on the control variable, so the coefficient on X reflects its relationship with Y among comparable units]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It removes the control variable from the dataset entirely]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It guarantees that the remaining coefficients are causal]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It increases the sample size]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q08</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A study finds that owning a gym membership predicts better health outcomes. When income is added to the model, the coefficient on gym membership shrinks dramatically. What does this suggest?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Income is likely a confounding variable: wealthier people are more likely to own gym memberships and also tend to be healthier]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Gym memberships cause higher income]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Income is unrelated to both gym memberships and health]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The original finding was due to measurement error]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q09</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A researcher adds several control variables to a regression and finds that the coefficient on the main explanatory variable remains statistically significant. Can the researcher conclude that the relationship is causal?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[No, because there may be unobserved confounders or reverse causality that controls cannot address]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, because controlling for confounders eliminates all alternative explanations]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Yes, as long as R-squared is high enough]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[No, because adding controls always makes coefficients insignificant]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q10</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What does an R-squared value of 0.60 mean?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[60% of the variance in the dependent variable is explained by the independent variable(s)]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The slope equals 0.60]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[60% of observations lie exactly on the regression line]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The correlation between X and Y is 0.60]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q11</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What does the standard error of a slope coefficient measure?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[How much the estimated slope would vary if we drew repeated samples from the same population]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[How spread out the observed values of the dependent variable are]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The difference between the largest and smallest values of the independent variable]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[How far each observation is from the regression line]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q12</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A regression produces a slope of 3.5 with a standard error of 0.5. Another regression produces a slope of 3.5 with a standard error of 2.5. Which statement is correct?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The first estimate is more precise because its standard error is smaller]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The second estimate is more precise because its standard error is larger]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Both estimates are equally precise because the slopes are the same]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Precision cannot be determined from the standard error]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>W10_Q13</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What does the standard deviation measure?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[How spread out the observed values of a variable are]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[How much a slope coefficient would vary across repeated samples]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Whether a coefficient is statistically significant]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The predicted value of the dependent variable]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
  </question>
