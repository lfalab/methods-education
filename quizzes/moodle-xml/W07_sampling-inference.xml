    <answer fraction="0" format="html">
      <text><![CDATA[This is a probability sample because every viewer has a chance to respond]]></text>
      <feedback format="html">
        <text></text>
      </feedback>
    </answer>
    <answer fraction="100" format="html">
      <text><![CDATA[This is a non-probability sample and cannot support a valid inference about the general population]]></text>
      <feedback format="html">
        <text></text>
