  <question type="multichoice">
    <name>
      <text>W07_Q02</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A television network conducts a poll by asking viewers to text their opinions on a political issue. Which statement best describes this sampling method?</p>]]></text>
